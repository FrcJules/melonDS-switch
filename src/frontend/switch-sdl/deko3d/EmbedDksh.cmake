# cmake -DOUT=<header> -DINPUTS=<name>=<file>|<name>=<file>... -P EmbedDksh.cmake : compiled shaders as byte arrays
set(text "// generated by EmbedDksh.cmake, do not edit\n#pragma once\n#include <stdint.h>\n")
string(REPLACE "|" ";" INPUTS "${INPUTS}")
foreach(pair ${INPUTS})
    string(REPLACE "=" ";" parts "${pair}")
    list(GET parts 0 name)
    list(GET parts 1 file)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR size "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND text "alignas(256) static const uint8_t ${name}[] = {${bytes}};\nstatic const uint32_t ${name}Size = ${size};\n")
endforeach()
file(WRITE "${OUT}" "${text}")
